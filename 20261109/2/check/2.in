T = Triangle([0, 0], [4, 0], [0, 4])
U = Triangle((0, 0), (2, 0), (0, 2))
V = Triangle((2, 2), (4, 4), (1, 3))
W = Triangle((3, 3), (5, 3), (3, 5))
E = Triangle((0, 0), (1, 0), (2, 0))
print(*(f"{n}({bool(x)}):{round(abs(x), 3)}" for n, x in zip("TUVWE", (T, U, V, W, E))))
print(f"{U < T=}, {U < V=}, {V < U=}, {W < T=}")
print(f"{U in T=}, {T in U=}, {V in T=}, {W in W=}, {E in W=}")
print(f"{T & U=}, {T & V=}, {U & V=}, {T & W=}, {E & T=}")
